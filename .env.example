DATABASE_URL=postgres://before_launch:before_launch@127.0.0.1:54329/before_launch
LOCAL_STORAGE_DIR=.data/storage
# Local files outside Vercel; hosted uploads require blob and a private store.
SOURCE_STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
# Alternative to a token: private store ID plus VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=
SIMULATION_ENGINE=auto
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
# Generate a random 32-byte access key; keep it private. Required even for demo.
OPERATOR_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
MAX_URL_BYTES=2097152
URL_FETCH_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
