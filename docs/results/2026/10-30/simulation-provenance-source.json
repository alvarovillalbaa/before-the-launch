  "case_files": [
    {
      "path": "tests/unit/simulation-provenance.test.ts",
      "names": [
        "simulation provenance: a selected finding needs its own matching Gateway judgment stamp",
        "simulation provenance: explicitly bound fake findings stay synthetic",
        "simulation provenance: a bound Gateway failure is distinguished from a Gateway judgment",
        "simulation provenance: configured Gateway alone never establishes a completed result origin",
        "simulation provenance: historical fake-engine findings retain qualified synthetic provenance",
        "simulation provenance: an unbound historical fallback event does not identify the selected finding",
        "simulation provenance: judgments attached to another finding cannot promote this finding",
        "simulation provenance: selected finding proof is not replaced by an unbound fallback from another attempt",
        "simulation provenance: duplicate matching stamps are ambiguous even when their values agree",
        "simulation provenance: conflicting selected-finding origins are never resolved by event order",
        "simulation provenance: malformed versions origins and configured-engine contradictions reject positive attribution",
        "simulation provenance: malformed unbound origin records cannot piggyback on valid selected-finding proof",
        "simulation provenance: absent findings remain pending regardless of stale judgment events",
        "simulation provenance: malformed finding results cannot inherit a positive engine label",
        "simulation provenance: unknown historical engine names do not become Gateway evidence",
        "simulation provenance: classification leaves scores evidence and event metadata unchanged",
        "simulation provenance: a complete Gateway cohort counts every independently derived judgment",
        "simulation provenance: explicit fake and Gateway fallback findings are both synthetic without collapsing their counts",
        "simulation provenance: mixed Gateway and fallback output cannot be advertised as all Gateway",
        "simulation provenance: unknown and pending findings remain visible in aggregate accounting",
        "simulation provenance: an empty cohort is pending rather than evidence of successful Gateway execution",
        "simulation provenance: exported Markdown retains the derived origin label and its qualification",
        "simulation provenance: aggregate binding accepts only the exact output identities with order-independent finding membership",
        "simulation provenance: missing duplicated or mismatched selected outputs cannot borrow another attempt origin",
        "simulation provenance: output identities alone do not validate a contradictory recorded summary",
        "simulation provenance: absent legacy output binding preserves persona counts but qualifies aggregate origin",
        "simulation provenance: output binding never mutates its summaries or immutable receipt"
      ]
    },
    {
      "path": "tests/unit/simulation-provenance-service.test.ts",
      "names": [
        "simulation provenance service: fake execution binds synthetic findings and report outputs without altering deterministic results",
        "simulation provenance service: successful mocked Gateway output is bound to its saved finding and aggregate outputs",
        "simulation provenance service: Gateway failure keeps fallback behavior while qualifying the exact synthetic finding and report",
        "simulation provenance service: mixed success and fallback persist separate origins with one correctly bound report composition",
        "simulation provenance service: historical Gateway flags and unbound fallback traces remain unknown without rewriting saved numerical outputs",
        "simulation provenance service: an older selected score or report cannot borrow a newer attempt aggregate attribution",
        "simulation provenance service: first selected historical findings cannot inherit current report lineage despite valid per-finding stamps",
        "simulation provenance service: unfinished agents stay pending and absent runs stay absent",
        "simulation provenance service: asynchronous changes to the loaded engine cannot relabel an already captured execution attempt"
      ]
    },
    {
      "path": "tests/unit/simulation-provenance-ui.test.tsx",
      "names": [
        "provenance UI: mixed findings retain separate Gateway and synthetic counts in a labeled notice",
        "provenance UI: fake and fallback cohorts remain explicitly synthetic after matched output linkage",
        "provenance UI: a pending cohort names missing findings without claiming completed Gateway output",
        "provenance UI: positive Gateway counts do not promote an unbound aggregate or report",
        "provenance UI: every persona origin exposes its visible label and full qualification",
        "provenance UI: authored markup stays escaped text without mutating provenance inputs"
      ]
    },
    {
      "path": "tests/unit/simulation.test.ts",
      "names": [
        "deterministic simulation runs fake agents concurrently and aggregates score components",
        "deterministic simulation retains the selected market in deterministic fake results without rewriting brief facts or evidence"
      ]
    },
    {
      "path": "tests/unit/simulation-context.test.ts",
      "names": [
        "persisted simulation target market uses the persisted market for fake findings, context trace, and report without filling missing brief facts",
        "persisted simulation target market passes the selected market separately from a conflicting brief market in the Gateway request",
        "persisted simulation target market retains the same selected market when a mocked Gateway failure falls back to fake output",
        "persisted simulation target market captures the persisted market before later asynchronous work can change the loaded record"
      ]
    }
  ],
