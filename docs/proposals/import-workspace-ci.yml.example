# INACTIVE. Install only after explicit backend/browser/temporary-CI approval.
# Remove the active workflow after the focused acceptance run.
name: Temporary import workspace acceptance
on:
  push:
    branches: [qa/import-workspace-acceptance]
    paths: [.github/workflows/import-workspace-acceptance.yml, tests/integration/product-intake.test.ts, tests/e2e/import-workspace.spec.ts]
permissions:
  contents: read
jobs:
  acceptance:
    if: github.repository == 'alvarovillalbaa/before-the-launch' && github.event.repository.private == false && github.ref == 'refs/heads/qa/import-workspace-acceptance'
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_DB: before_launch_intake_ci
          POSTGRES_USER: intake_ci
          POSTGRES_PASSWORD: disposable_ci_only
        ports: ['54329:5432']
        options: >-
          --health-cmd "pg_isready -U intake_ci -d before_launch_intake_ci"
          --health-interval 5s --health-timeout 5s --health-retries 12
    env:
      CI: "true"
      NEXT_TELEMETRY_DISABLED: "1"
      DO_NOT_TRACK: "1"
      DATABASE_URL: postgres://intake_ci:disposable_ci_only@127.0.0.1:54329/before_launch_intake_ci
      INTAKE_ACCEPTANCE_FIXTURES: disposable
      SIMULATION_ENGINE: fake
      AI_GATEWAY_API_KEY: ""
      VERCEL_OIDC_TOKEN: ""
      BLOB_READ_WRITE_TOKEN: ""
      OPENAI_API_KEY: ""
      ANTHROPIC_API_KEY: ""
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Verify and identify the reviewed source
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
          if (process.version !== 'v24.21.0' || pkg.packageManager !== 'pnpm@10.24.0') throw new Error('Re-review changed baseline.');
          if (pkg.dependencies.next !== '16.2.9') throw new Error('Re-review changed Next baseline.');
          NODE
          git rev-parse HEAD
          sha256sum package.json pnpm-lock.yaml lib/server/services/product-intake-service.ts tests/integration/product-intake.test.ts tests/e2e/import-workspace.spec.ts
      - name: Name the operation-owned runner storage
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const path = require('node:path');
          const storage = path.join(process.env.RUNNER_TEMP, 'before-launch-intake-' + process.env.GITHUB_RUN_ID);
          fs.appendFileSync(process.env.GITHUB_ENV, 'LOCAL_STORAGE_DIR=' + storage + '\n');
          NODE
      - name: Install existing locked dependencies in the disposable runner
        run: |
          corepack enable
          corepack prepare pnpm@10.24.0 --activate
          corepack pnpm install --frozen-lockfile --ignore-scripts
      - name: Lint only the changed product and acceptance files
        run: >-
          corepack pnpm exec eslint
          app/intake-actions.ts app/page.tsx app/projects/new/page.tsx
          app/projects/\[projectId\]/page.tsx app/runs/page.tsx app/new-simulation/page.tsx
          components/app-shell.tsx components/app-sidebar.tsx components/product-upload-intake.tsx
          lib/shared/product-intake.ts lib/server/services/product-intake-service.ts
          tests/integration/product-intake.test.ts tests/e2e/import-workspace.spec.ts
      - name: Apply only the existing schema to the empty disposable database
        run: corepack pnpm exec drizzle-kit push --force
      - name: Prepare focused runner-only test configurations
        run: |
          cat > .intake-ci.vitest.config.ts <<'CONFIG'
          import { defineConfig } from 'vitest/config';
          export default defineConfig({
            resolve: { alias: { '@': new URL('.', import.meta.url).pathname } },
            test: {
              environment: 'node',
              include: ['tests/integration/product-intake.test.ts'],
              fileParallelism: false,
              maxWorkers: 1,
              testTimeout: 30_000,
              hookTimeout: 30_000,
              reporters: ['default'],
            },
          });
          CONFIG
          cat > .intake-ci.playwright.config.ts <<'CONFIG'
          import { defineConfig, devices } from '@playwright/test';
          const baseURL = 'http://127.0.0.1:3100';
          export default defineConfig({
            testDir: './tests/e2e',
            testMatch: '**/import-workspace.spec.ts',
            forbidOnly: true,
            fullyParallel: false,
            workers: 1,
            retries: 0,
            timeout: 60_000,
            globalTimeout: 360_000,
            expect: { timeout: 15_000 },
            reporter: 'line',
            outputDir: 'test-results/import-ci',
            use: { baseURL, trace: 'off', screenshot: 'off', video: 'off', serviceWorkers: 'block' },
            projects: [{ name: 'chromium', use: { ...devices['Desktop Chrome'] } }],
            webServer: {
              command: 'corepack pnpm dev --hostname 127.0.0.1 --port 3100',
              url: baseURL,
              reuseExistingServer: false,
              timeout: 120_000,
              env: { NODE_ENV: 'development', SIMULATION_ENGINE: 'fake', AI_GATEWAY_API_KEY: '', VERCEL_OIDC_TOKEN: '', BLOB_READ_WRITE_TOKEN: '', NEXT_TELEMETRY_DISABLED: '1' },
            },
          });
          CONFIG
      - name: Verify parsing and atomic persistence against disposable PostgreSQL
        run: corepack pnpm exec vitest run --config .intake-ci.vitest.config.ts
      - name: Install only Chromium and Linux browser dependencies
        run: corepack pnpm exec playwright install --with-deps chromium
      - name: Run only the four desktop and mobile import workspace scenarios
        run: corepack pnpm exec playwright test --config .intake-ci.playwright.config.ts --project chromium
      - name: Show bounded authored-fixture context on failure
        if: failure()
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const path = require('node:path');
          const root = 'test-results/import-ci';
          if (fs.existsSync(root)) {
            for (const file of fs.readdirSync(root, { recursive: true }).filter(name => name.endsWith('error-context.md')).slice(0, 4)) {
              process.stdout.write('IMPORT_FAILURE_CONTEXT ' + file + '\n');
              process.stdout.write(fs.readFileSync(path.join(root, file), 'utf8').split('\n').slice(0, 100).join('\n') + '\n');
            }
          }
          NODE
